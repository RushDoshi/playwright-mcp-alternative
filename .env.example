# ============================================================================
# playwright-mcp-alternative — host configuration. Copy to .env and fill in.
# All secrets live ONLY here on the host; agents never carry their own.
# ============================================================================

# --- Host ---
HOST_NAME=host-vm-qa-01
WORKSPACE_DIR=/app/workspace
STATE_DIR=/app/state
LOG_LEVEL=INFO

# --- Security ---
# Shared secret checked on every mutating endpoint (X-Webhook-Token header).
# Leave empty for localhost-only dev; MUST be set before exposing the service.
WEBHOOK_SECRET=

# --- Jira ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=changeme
JIRA_READY_STATUS=Ready for Development
JIRA_INPROGRESS_STATUS=In Progress
JIRA_INREVIEW_STATUS=In Review
AUTO_START_UITEST_ON_READY=true
JIRA_POLL_INTERVAL_SECONDS=30
JIRA_POLL_MAX_CONCURRENT=10
# Pull-based trigger (alternative to a Jira Automation webhook). Leave both
# empty unless you scope the JQL explicitly, e.g. "project = PROJ".
JIRA_READY_JQL=
JIRA_READY_POLL_INTERVAL_SECONDS=0

# --- UI tests (Playwright) ---
TEST_ENV=staging
TEST_USER=
TEST_PASS=
TICKET_KEY=
# Local/demo only: watch the run in a real Chrome window. Keep false on a host.
PLAYWRIGHT_HEADED=false

# --- Bitbucket (optional; PR creation) ---
BITBUCKET_WORKSPACE=
BITBUCKET_USER=
BITBUCKET_APP_PASSWORD=

# --- Claude Code ---
# IMPORTANT: this project uses your Claude Pro/Max subscription login
# (`claude login`) — NOT a metered API key. Leave ANTHROPIC_API_KEY empty (or
# a placeholder like "changeme") and the CLI falls back to your logged-in
# session. Only set it if you deliberately want key-based billing.
ANTHROPIC_API_KEY=changeme
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT_SECONDS=1800

# --- Jenkins (optional; regression workflow) ---
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_REGRESSION_JOB=LoadTesting/Regression

# --- Azure Spot VM (optional; regression workflow) ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=qa-regression-rg
AZURE_VM_SIZE=Standard_D4s_v5
AZURE_VM_NAME_PREFIX=vm-qa-spot
AZURE_LOCATION=eastus

# --- SMTP / Email (optional; regression report) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM=qa-bot@example.com
REPORT_TO=qa-team@example.com
